---
// End mark: a small shape sitting on a double-line horizon.
interface Props {
  class?: string;
  shape?: 'sun' | 'moon' | 'pines' | 'ziggurat';
}

const { class: className, shape = 'sun' } = Astro.props;
---

<div class:list={['fin', className]} aria-hidden="true">
  <span class="line"></span>
  <svg viewBox="0 0 48 24" fill="currentColor">
    {shape === 'sun' && (
      <>
        <path d="M17 24a7 7 0 0 1 14 0z" />
        <path stroke="currentColor" stroke-width="2" d="M33.24 20.17 44.33 15.58M31.07 16.93 39.56 8.44M27.83 14.76 32.42 3.67M24 14V2M20.17 14.76 15.58 3.67M16.93 16.93 8.44 8.44M14.76 20.17 3.67 15.58" />
      </>
    )}
    {shape === 'moon' && (
      <>
        <mask id="fin-moon-cut">
          <rect width="48" height="24" fill="#fff" />
          <circle cx="28.5" cy="9.5" r="7.5" fill="#000" />
        </mask>
        <circle cx="24" cy="13" r="8.5" mask="url(#fin-moon-cut)" />
        <path d="M39 4l.8 2.2L42 7l-2.2.8L39 10l-.8-2.2L36 7l2.2-.8zM9 10l.5 1.5L11 12l-1.5.5L9 14l-.5-1.5L7 12l1.5-.5zM43 15.5l.4 1.1 1.1.4-1.1.4-.4 1.1-.4-1.1-1.1-.4 1.1-.4z" />
      </>
    )}
    {shape === 'pines' && (
      <path d="M24 2l5 10h-2.5L31 24H17l4.5-12H19zM12 9l3.5 7H14l3 8H7l3-8H8.5zM36 9l3.5 7H38l3 8H31l3-8h-1.5z" />
    )}
    {shape === 'ziggurat' && (
      <path d="M9 24v-4h4v-4h4v-4h4V8h6v4h4v4h4v4h4v4zM24 1l3 3-3 3-3-3z" />
    )}
  </svg>
  <span class="line"></span>
</div>

<style>
  .fin {
    display: flex;
    align-items: flex-end;
    gap: var(--space-sm);
    margin-top: var(--space-2xl);
    color: var(--color-sienna);
  }

  svg {
    width: 3rem;
    height: 1.5rem;
  }

  .line {
    flex-grow: 1;
    height: 5px;
    border-block: 1px solid var(--color-olive);
  }
</style>
