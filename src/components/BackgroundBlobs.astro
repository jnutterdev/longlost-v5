<div class="blobs" aria-hidden="true">
  <!--
    data-drift: horizontal travel over the full page as a fraction of viewport width; values mirror each blob to the opposite side.
    data-lift: peak upward rise at mid-page as a fraction of viewport height; the blob arcs up and settles back by the bottom.
  -->
  <div class="blob blob-1" data-drift="0.7"></div>
  <div class="blob blob-2" data-drift="-0.8" data-lift="0.35"></div>
  <div class="blob blob-3" data-drift="0.3"></div>
</div>
<div class="noise-bg" aria-hidden="true"></div>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const blobs = document.querySelectorAll<HTMLElement>('[data-drift]');
  let ticking = false;

  // Drift is tied to scroll progress (0 at top, 1 at bottom) so long pages
  // don't push the blobs off-screen.
  const update = (): void => {
    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    const progress = scrollable > 0 ? window.scrollY / scrollable : 0;
    for (const blob of blobs) {
      const x = Number(blob.dataset.drift) * progress * window.innerWidth;
      const y = -Number(blob.dataset.lift ?? 0) * Math.sin(progress * Math.PI) * window.innerHeight;
      blob.style.transform = `translate(${x}px, ${y}px)`;
    }
    ticking = false;
  };

  const requestUpdate = (): void => {
    if (reducedMotion.matches || ticking) return;
    ticking = true;
    window.requestAnimationFrame(update);
  };

  window.addEventListener('scroll', requestUpdate, { passive: true });
  window.addEventListener('resize', requestUpdate, { passive: true });
  requestUpdate();
</script>

<style>
  .blobs {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }

  .blob-1 {
    width: 50vw;
    height: 50vw;
    top: -10%;
    left: -10%;
    background: rgb(58 71 80 / 0.45);
    filter: blur(110px);
  }

  .blob-2 {
    width: 60vw;
    height: 60vw;
    top: 20%;
    right: -20%;
    background: rgb(234 146 22 / 0.12);
    filter: blur(130px);
  }

  .blob-3 {
    width: 40vw;
    height: 40vw;
    bottom: -10%;
    left: 15%;
    background: rgb(138 150 163 / 0.3);
    filter: blur(90px);
  }
</style>
