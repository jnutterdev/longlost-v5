---
import { tagSlug } from '../lib/posts';

interface Props {
  tags: string[];
  linked?: boolean;
}

const { tags, linked = true } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tags">
    {tags.map(tag => (
      <li>
        {linked
          ? <a class="tag" href={`/archive/tag/${tagSlug(tag)}`}>{tag}</a>
          : <span class="tag">{tag}</span>}
      </li>
    ))}
  </ul>
)}

<style>
  .tags {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tag {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text);
    background: rgb(49 56 65 / 0.5);
    border: 1px solid var(--color-slate);
    transition: background-color var(--ease), color var(--ease), border-color var(--ease);
  }

  a.tag:hover,
  a.tag:focus-visible {
    background: var(--color-accent);
    color: var(--color-hightide);
    border-color: var(--color-accent);
  }
</style>
