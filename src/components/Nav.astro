---
import ThemeControls from './ThemeControls.astro';

interface NavItem {
  label: string;
  href: string;
}

const items: NavItem[] = [
  { label: 'Home', href: '/' },
  { label: 'Archive', href: '/archive' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string): boolean =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<nav class="nav container" aria-label="Main navigation">
  <a rel="me" href="/" class="logo">longlostforgotten.</a>

  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="nav-links"
    data-menu-toggle
  >
    <span class="sr-only">Toggle menu</span>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path stroke-linecap="square" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
    </svg>
  </button>

  <div class="nav-end">
    <ul id="nav-links" class="links" data-menu>
      {items.map(item => (
        <li>
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="menu-settings">
        <ThemeControls idPrefix="menu" />
      </li>
    </ul>

    <button
      class="settings-toggle"
      type="button"
      popovertarget="theme-panel"
      aria-label="Display settings"
      data-settings-toggle
    >
      <svg aria-hidden="true" viewBox="0 0 512 512" fill="currentColor">
        <path d="M0 416c0 17.7 14.3 32 32 32l54.7 0c12.3 28.3 40.5 48 73.3 48s61-19.7 73.3-48L480 448c17.7 0 32-14.3 32-32s-14.3-32-32-32l-246.7 0c-12.3-28.3-40.5-48-73.3-48s-61 19.7-73.3 48L32 384c-17.7 0-32 14.3-32 32zm128 0a32 32 0 1 1 64 0 32 32 0 1 1 -64 0zM320 256a32 32 0 1 1 64 0 32 32 0 1 1 -64 0zm32-80c-32.8 0-61 19.7-73.3 48L32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l246.7 0c12.3 28.3 40.5 48 73.3 48s61-19.7 73.3-48l54.7 0c17.7 0 32-14.3 32-32s-14.3-32-32-32l-54.7 0c-12.3-28.3-40.5-48-73.3-48zM192 128a32 32 0 1 1 0-64 32 32 0 1 1 0 64zm73.3-64C253 35.7 224.8 16 192 16s-61 19.7-73.3 48L32 64C14.3 64 0 78.3 0 96s14.3 32 32 32l86.7 0c12.3 28.3 40.5 48 73.3 48s61-19.7 73.3-48L480 128c17.7 0 32-14.3 32-32s-14.3-32-32-32L265.3 64z" />
      </svg>
    </button>
  </div>

  <div id="theme-panel" class="theme-panel" popover data-settings-panel>
    <ThemeControls idPrefix="panel" />
  </div>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLUListElement>('[data-menu]');

  const setOpen = (open: boolean): void => {
    toggle?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('open', open);
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu?.classList.contains('open')) {
      setOpen(false);
      toggle?.focus();
    }
  });

  const settingsToggle = document.querySelector<HTMLButtonElement>('[data-settings-toggle]');
  const settingsPanel = document.querySelector<HTMLElement>('[data-settings-panel]');
  const PANEL_OFFSET = 12;

  // Popovers render in the top layer, so pin the panel under the button in page coordinates.
  settingsPanel?.addEventListener('beforetoggle', event => {
    if ((event as ToggleEvent).newState !== 'open' || !settingsToggle) return;
    const rect = settingsToggle.getBoundingClientRect();
    settingsPanel.style.top = `${rect.bottom + window.scrollY + PANEL_OFFSET}px`;
    settingsPanel.style.right = `${document.documentElement.clientWidth - rect.right}px`;
  });
</script>

<style>
  .nav {
    position: relative;
    /* Above .main (z-index 10) so the mobile dropdown overlays page content. */
    z-index: 20;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: var(--space-lg);
  }

  .logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    letter-spacing: -0.025em;
    text-decoration: none;
    color: var(--color-text);
    transition: color var(--ease);
  }

  .logo:hover {
    color: var(--color-accent);
  }

  .menu-toggle {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    padding: var(--space-xs);
    background: none;
    border: none;
    color: var(--color-meta);
    cursor: pointer;
  }

  .menu-toggle:hover {
    color: var(--color-accent);
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .settings-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: var(--space-2xs);
    background: none;
    border: none;
    color: var(--color-meta);
    cursor: pointer;
    transition: color var(--ease);
  }

  .settings-toggle svg {
    width: 1rem;
    height: 1rem;
  }

  .settings-toggle:hover {
    color: var(--color-accent);
  }

  .theme-panel {
    position: absolute;
    inset: auto;
    margin: 0;
    padding: var(--space-md);
    min-width: 15rem;
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--border-card);
    box-shadow: var(--shadow-offset);
  }

  .menu-settings {
    display: none;
  }

  .links {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    position: relative;
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-meta);
    transition: color var(--ease);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 2px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: bottom right;
    transition: transform 0.25s ease-out;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
    transform-origin: bottom left;
  }

  @media (max-width: 47.99rem) {
    .menu-toggle {
      display: block;
    }

    .links {
      display: none;
      position: absolute;
      top: 100%;
      right: var(--gutter);
      left: var(--gutter);
      flex-direction: column;
      gap: 0;
      background: var(--color-bg);
      border: var(--border-card);
      box-shadow: var(--shadow-offset);
    }

    .links.open {
      display: flex;
    }

    .links li + li {
      border-top: 1px solid var(--color-border);
    }

    .nav-link {
      display: block;
      padding: var(--space-sm) var(--space-md);
    }

    .nav-link::after {
      display: none;
    }

    /* The settings move into the dropdown, so the wrapper drops out of the flex row. */
    .nav-end {
      display: contents;
    }

    .settings-toggle,
    .theme-panel {
      display: none;
    }

    .menu-settings {
      display: block;
      padding: var(--space-sm) var(--space-md) var(--space-md);
    }
  }
</style>
