---
interface Props {
  title: string;
  level?: 'h1' | 'h2';
}

const { title, level: Heading = 'h2' } = Astro.props;
---

<div class="section-heading">
  <Heading class="title">{title}</Heading>
  <div class="rule" aria-hidden="true"></div>
  <slot />
</div>

<style>
  .section-heading {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }

  .title {
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
  }

  /* Deco rule: a double line that ends in a sienna diamond. */
  .rule {
    position: relative;
    flex-grow: 1;
    height: 0.75rem;
  }

  .rule::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 1rem;
    height: 5px;
    border-block: 1px solid var(--color-border);
    transform: translateY(-50%);
  }

  .rule::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 1px;
    width: 7px;
    height: 7px;
    background: var(--color-accent-hot);
    transform: translateY(-50%) rotate(45deg);
  }

  @media (min-width: 48rem) {
    .title {
      font-size: var(--text-2xl);
      white-space: nowrap;
    }
  }
</style>
