---
import Fin from './Fin.astro';

const startYear = 2001;
const year = new Date().getFullYear();
---

<footer class="footer">
  <Fin class="horizon" />
  <div class="inner container">
    <div class="meta">
      <p class="copy">&copy; {startYear}&ndash;{year} longlostforgotten.</p>
      <p class="colophon">
        made in decatur, ga &middot; built with astro + tina by <a href="https://ashtephra.com">ashtephra</a>
      </p>
    </div>
    <div class="social">
      <a href="/rss.xml" class="icon-link">
        <span class="sr-only">RSS feed</span>
        <svg aria-hidden="true" viewBox="0 0 448 512" fill="currentColor">
          <path d="M0 64C0 46.3 14.3 32 32 32c229.8 0 416 186.2 416 416c0 17.7-14.3 32-32 32s-32-14.3-32-32C384 253.6 226.4 96 32 96C14.3 96 0 81.7 0 64zM0 416a64 64 0 1 1 128 0A64 64 0 1 1 0 416zM32 160c159.1 0 288 128.9 288 288c0 17.7-14.3 32-32 32s-32-14.3-32-32c0-123.7-100.3-224-224-224c-17.7 0-32-14.3-32-32s14.3-32 32-32z" />
        </svg>
      </a>
      <a href="https://bsky.app/profile/longlostforgotten.com" class="icon-link" rel="me">
        <span class="sr-only">Bluesky</span>
        <svg aria-hidden="true" viewBox="0 0 576 512" fill="currentColor">
          <path d="M407.8 294.7c-3.3-.4-6.7-.8-10-1.3c3.4 .4 6.7 .9 10 1.3zM288 227.1C261.9 176.4 190.9 81.9 124.9 35.3C61.6-9.4 37.5-1.7 21.6 5.5C3.3 13.8 0 41.9 0 58.4S9.1 194 15 213.9c19.5 65.7 89.1 87.9 153.2 80.7c3.3-.5 6.6-.9 10-1.4c-3.3 .5-6.6 1-10 1.4C74.3 308.6-9.1 342.8 100.3 464.5C220.6 589.1 265.1 437.8 288 361.1c22.9 76.7 49.2 222.5 185.6 103.4c102.4-103.4 28.1-156-65.8-169.9c-3.3-.4-6.7-.8-10-1.3c3.4 .4 6.7 .9 10 1.3c64.1 7.1 133.6-15.1 153.2-80.7C566.9 194 576 75 576 58.4s-3.3-44.7-21.6-53c-15.9-7.2-40-14.9-103.2 29.8C385.1 81.9 314.1 176.4 288 227.1z" />
        </svg>
      </a>
      <a href="https://mastodon.social/@longlostforgotten" class="icon-link" rel="me">
        <span class="sr-only">Mastodon</span>
        <svg aria-hidden="true" viewBox="0 0 448 512" fill="currentColor">
          <path d="M433 179.1c0-97.2-63.7-125.7-63.7-125.7-62.5-28.7-228.6-28.4-290.5 0 0 0-63.7 28.5-63.7 125.7 0 115.7-6.6 259.4 105.6 289.1 40.5 10.7 75.3 13 103.3 11.4 50.8-2.8 79.3-18.1 79.3-18.1l-1.7-36.9s-36.3 11.4-77.1 10.1c-40.4-1.4-83-4.4-89.6-54a102.5 102.5 0 0 1-.9-13.9c85.6 20.9 158.7 9.1 178.8 6.7 56.1-6.7 105-41.3 111.2-72.9 9.8-49.8 9-121.5 9-121.5zm-75.1 125.2h-46.6V190.1c0-49.7-64-51.6-64-6.9v62.5h-46.3V197c0-44.7-64-42.8-64 6.9v114.2H90.2c0-122.1-5.2-147.9 18.4-175 25.9-28.9 79.8-30.8 103.8 6.1l11.6 19.5 11.6-19.5c24.1-37.1 78.1-34.8 103.8-6.1 23.7 27.3 18.4 53 18.4 175z" />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 10;
    margin-top: auto;
    padding-block: var(--space-2xl) var(--space-lg);
  }

  /* The sun rises above the footer; its double line is the footer's top edge. */
  .footer :global(.horizon) {
    position: absolute;
    bottom: 100%;
    left: 0;
    right: 0;
    margin-top: 0;
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .copy {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-khaki);
  }

  .meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .colophon {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-khaki);
  }

  .colophon a {
    color: inherit;
    text-decoration-color: var(--color-accent);
    transition: color var(--ease);
  }

  .colophon a:hover {
    color: var(--color-accent);
  }

  .social {
    display: flex;
    gap: var(--space-md);
  }

  .icon-link {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-khaki);
    transition: color var(--ease);
  }

  .icon-link:hover {
    color: var(--color-accent);
  }

  .icon-link svg {
    width: 100%;
    height: 100%;
  }

  @media (min-width: 48rem) {
    .inner {
      flex-direction: row;
    }

    .meta {
      align-items: flex-start;
    }
  }
</style>
