---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TagCloud from '../../components/TagCloud.astro';
import ArchiveList from '../../components/ArchiveList.astro';import { getAllTags, getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---

<Base title="Archive" description="Every transmission, sorted by year.">
  <SectionHeading title="The Archive" level="h1" />
  <TagCloud tags={tags} />
  <ArchiveList posts={posts} />
</Base>
