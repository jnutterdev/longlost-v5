---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagList from '../../components/TagList.astro';
import Fin from '../../components/Fin.astro';
import { formatLongDate } from '../../lib/format-date';
import { getPublishedPhotos, type Photo } from '../../lib/posts';
import '../../styles/prose.css';

interface Props {
  photo: Photo;
  newer?: Photo;
  older?: Photo;
}

export const getStaticPaths = (async () => {
  const photos = await getPublishedPhotos();
  return photos.map((photo, index) => ({
    params: { slug: photo.id },
    props: { photo, newer: photos[index - 1], older: photos[index + 1] },
  }));
}) satisfies GetStaticPaths;

const { photo, newer, older } = Astro.props;
const { Content } = await render(photo);
const { title, image, alt, date, location, tags } = photo.data;
---

<Base title={title} description={alt} image={image}>
  <a href="/gallery" class="back">&larr; Gallery</a>

  <article class="photo">
    <figure class="frame">
      <img src={image} alt={alt} loading="eager" decoding="async" />
    </figure>

    <div class="details">
      <p class="meta">
        <time datetime={date}>{formatLongDate(date)}</time>
        {location && <><span class="sep" aria-hidden="true">/</span><span>{location}</span></>}
      </p>
      <h1 class="title">{title}</h1>
      <div class="prose caption">
        <Content />
      </div>
      <TagList tags={tags} linked={false} />

      <Fin shape="ziggurat" />

      <nav class="pager" aria-label="More photos">
        {newer && <a href={`/gallery/${newer.id}/`}>&larr; Newer</a>}
        {older && <a href={`/gallery/${older.id}/`}>Older &rarr;</a>}
      </nav>
    </div>
  </article>
</Base>

<style>
  .back {
    display: inline-block;
    margin-block: var(--space-lg);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-khaki);
    transition: color var(--ease);
  }

  .back:hover {
    color: var(--color-accent);
  }

  .photo {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  .frame {
    margin: 0;
    border: var(--border-card);
    box-shadow: var(--shadow-offset);
    background: var(--color-ink);
  }

  .frame img {
    width: 100%;
    max-height: 80vh;
    object-fit: contain;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .sep {
    color: var(--color-olive);
  }

  .title {
    margin-bottom: var(--space-md);
    font-size: var(--text-3xl);
    line-height: 1.05;
    color: var(--color-text);
  }

  .caption {
    margin-bottom: var(--space-md);
    font-size: var(--text-base);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-top: var(--space-md);
  }

  .pager a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-khaki);
    transition: color var(--ease);
  }

  .pager a:hover {
    color: var(--color-accent);
  }

  @media (min-width: 64rem) {
    .photo {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }

    .details {
      position: sticky;
      top: var(--space-lg);
    }
  }
</style>
