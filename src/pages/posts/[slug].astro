---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DuotoneImage from '../../components/DuotoneImage.astro';
import TagList from '../../components/TagList.astro';
import BlueskyComments from '../../components/BlueskyComments.astro';
import Fin from '../../components/Fin.astro';
import { formatLongDate } from '../../lib/format-date';
import { getExcerpt, getPublishedPosts, type Post } from '../../lib/posts';
import '../../styles/prose.css';

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, date, readTime, image, tag, currentMood, currentMusic, blueskyUrl, mastodonUrl } = post.data;
---

<Base title={title} description={getExcerpt(post, 160)} image={image}>
  <article class="post">
    <header class="header">
      <a href="/archive" class="back">&larr; Archive</a>
      <p class="meta">
        <time datetime={date}>{formatLongDate(date)}</time>
        {readTime && <><span class="sep" aria-hidden="true">/</span><span>{readTime}</span></>}
      </p>
      <h1 class="title">{title}</h1>
      <TagList tags={tag} />
    </header>

    {image && (
      <div class="punk-card feature-image">
        <DuotoneImage src={image} alt="" loading="eager" class="feature-media" />
      </div>
    )}

    <div class="prose body">
      <Content />
    </div>

    <Fin shape="moon" />

    {(currentMood || currentMusic) && (
      <dl class="vibes">
        {currentMood && (
          <div class="vibe">
            <dt>Mood</dt>
            <dd>{currentMood}</dd>
          </div>
        )}
        {currentMusic && (
          <div class="vibe">
            <dt>Listening to</dt>
            <dd>{currentMusic}</dd>
          </div>
        )}
      </dl>
    )}

    {(blueskyUrl || mastodonUrl) && (
      <aside class="discussion">
        <p class="discussion-label">Join the discussion</p>
        <div class="discussion-links">
          {blueskyUrl && (
            <a href={blueskyUrl} target="_blank" rel="noopener noreferrer" class="discussion-link">
              <svg aria-hidden="true" viewBox="0 0 576 512" fill="currentColor">
                <path d="M407.8 294.7c-3.3-.4-6.7-.8-10-1.3c3.4 .4 6.7 .9 10 1.3zM288 227.1C261.9 176.4 190.9 81.9 124.9 35.3C61.6-9.4 37.5-1.7 21.6 5.5C3.3 13.8 0 41.9 0 58.4S9.1 194 15 213.9c19.5 65.7 89.1 87.9 153.2 80.7c3.3-.5 6.6-.9 10-1.4c-3.3 .5-6.6 1-10 1.4C74.3 308.6-9.1 342.8 100.3 464.5C220.6 589.1 265.1 437.8 288 361.1c22.9 76.7 49.2 222.5 185.6 103.4c102.4-103.4 28.1-156-65.8-169.9c-3.3-.4-6.7-.8-10-1.3c3.4 .4 6.7 .9 10 1.3c64.1 7.1 133.6-15.1 153.2-80.7C566.9 194 576 75 576 58.4s-3.3-44.7-21.6-53c-15.9-7.2-40-14.9-103.2 29.8C385.1 81.9 314.1 176.4 288 227.1z" />
              </svg>
              <span>Bluesky</span>
            </a>
          )}
          {mastodonUrl && (
            <a href={mastodonUrl} target="_blank" rel="noopener noreferrer" class="discussion-link">
              <svg aria-hidden="true" viewBox="0 0 448 512" fill="currentColor">
                <path d="M433 179.1c0-97.2-63.7-125.7-63.7-125.7-62.5-28.7-228.6-28.4-290.5 0 0 0-63.7 28.5-63.7 125.7 0 115.7-6.6 259.4 105.6 289.1 40.5 10.7 75.3 13 103.3 11.4 50.8-2.8 79.3-18.1 79.3-18.1l-1.7-36.9s-36.3 11.4-77.1 10.1c-40.4-1.4-83-4.4-89.6-54a102.5 102.5 0 0 1-.9-13.9c85.6 20.9 158.7 9.1 178.8 6.7 56.1-6.7 105-41.3 111.2-72.9 9.8-49.8 9-121.5 9-121.5zm-75.1 125.2h-46.6V190.1c0-49.7-64-51.6-64-6.9v62.5h-46.3V197c0-44.7-64-42.8-64 6.9v114.2H90.2c0-122.1-5.2-147.9 18.4-175 25.9-28.9 79.8-30.8 103.8 6.1l11.6 19.5 11.6-19.5c24.1-37.1 78.1-34.8 103.8-6.1 23.7 27.3 18.4 53 18.4 175z" />
              </svg>
              <span>Mastodon</span>
            </a>
          )}
        </div>
      </aside>
    )}

    {blueskyUrl && <BlueskyComments blueskyUrl={blueskyUrl} />}
  </article>

  {(newer || older) && (
    <nav class="pager" aria-label="More posts">
      {older
        ? (
          <a class="punk-card pager-link" href={`/posts/${older.id}/`}>
            <span class="pager-label">&larr; Older</span>
            <span class="pager-title">{older.data.title}</span>
          </a>
        )
        : <span></span>}
      {newer && (
        <a class="punk-card pager-link newer" href={`/posts/${newer.id}/`}>
          <span class="pager-label">Newer &rarr;</span>
          <span class="pager-title">{newer.data.title}</span>
        </a>
      )}
    </nav>
  )}
</Base>

<style>
  .post {
    max-width: var(--prose-max);
    margin-inline: auto;
    padding-top: var(--space-lg);
  }

  .header {
    margin-bottom: var(--space-2xl);
  }

  .back {
    display: inline-block;
    margin-bottom: var(--space-lg);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-meta);
    transition: color var(--ease);
  }

  .back:hover {
    color: var(--color-accent);
  }

  .meta {
    display: flex;
    gap: var(--space-xs);
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .sep {
    color: var(--color-border);
  }

  .title {
    margin-bottom: var(--space-md);
    font-size: var(--text-3xl);
    line-height: 1.05;
    color: var(--color-text);
  }

  .feature-image {
    margin-bottom: var(--space-2xl);
  }

  .feature-image:hover {
    transform: none;
    box-shadow: var(--shadow-offset);
    border-color: var(--color-border);
  }

  .feature-image :global(.feature-media) {
    aspect-ratio: 16 / 9;
  }

  .vibes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    margin: var(--space-2xl) 0 0;
    padding: var(--space-sm) var(--space-md);
    border-left: 2px solid var(--color-meta);
    background: color-mix(in srgb, var(--color-meta) 10%, transparent);
  }

  .vibe dt {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-meta);
  }

  .vibe dd {
    margin: 0;
    color: var(--color-text);
  }

  .discussion {
    margin-top: var(--space-2xl);
  }

  .vibes + .discussion {
    margin-top: var(--space-md);
  }

  .discussion-label {
    margin-bottom: var(--space-xs);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-meta);
  }

  .discussion-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .discussion-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text);
    transition: color var(--ease);
  }

  .discussion-link svg {
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-meta);
    transition: color var(--ease);
  }

  .discussion-link:hover,
  .discussion-link:hover svg {
    color: var(--color-accent);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    max-width: var(--prose-max);
    margin: var(--space-3xl) auto 0;
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
    text-decoration: none;
  }

  .pager-label {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-meta);
  }

  .pager-title {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text);
    transition: color var(--ease);
  }

  .pager-link:hover .pager-title {
    color: var(--color-accent);
  }

  @media (min-width: 48rem) {
    .title {
      font-size: var(--text-5xl);
    }

    .pager {
      grid-template-columns: 1fr 1fr;
    }

    .newer {
      text-align: right;
    }
  }
</style>
