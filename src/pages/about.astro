---
import Base from "../layouts/Base.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Fin from "../components/Fin.astro";
import DuotoneImage from "../components/DuotoneImage.astro";
import about from "../content/about.json";

const bioParagraphs = about.bio
    .split(/\n\n+/)
    .filter((paragraph) => paragraph.trim());

const linkGroups = [
    { label: "elsewhere", links: about.links },
    { label: "websites", links: about.websites },
].filter((group) => group.links.length > 0);
---

<Base title="About" description={bioParagraphs[0]}>
    <SectionHeading title="About" level="h1" />

    <div class="about">
        <aside class="profile">
            {about.avatar && (
                <div class="avatar-frame">
                    <DuotoneImage
                        class="avatar"
                        src={about.avatar}
                        alt={about.avatarAlt}
                        loading="eager"
                    />
                </div>
            )}
            <p class="name">{about.name}</p>
            <p class="location">{about.location}</p>
        </aside>

        <div class="punk-card punk-card--branches punk-card--framed bio">
            {bioParagraphs.map((paragraph) => (
                <p>{paragraph}</p>
            ))}

            {linkGroups.map((group) => (
                <div class="link-group">
                    <p class="link-group-label">{group.label}</p>
                    <ul class="links">
                        {group.links.map((link) => (
                            <li>
                                <a href={link.url} rel="me">
                                    {link.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}

            <Fin shape="pines" />
        </div>
    </div>
</Base>

<style>
    .about {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-2xl);
    }

    /* Centered when stacked on mobile; left-aligned in the desktop sidebar. */
    .profile {
        text-align: center;
    }

    .avatar-frame {
        max-width: 16rem;
        margin: 0 auto var(--space-md);
        overflow: hidden;
        border: var(--border-card);
        border-radius: 999px 999px 0 0;
        box-shadow: var(--shadow-offset);
    }

    /* DuotoneImage fills its box, so the frame sets the shape. */
    .avatar-frame :global(.avatar) {
        aspect-ratio: 1;
    }

    .name {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: var(--text-xl);
        color: var(--color-text);
    }

    .location {
        margin: var(--space-2xs) 0 0;
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-widest);
        text-transform: uppercase;
        color: var(--color-slate);
    }

    .bio {
        padding: var(--space-lg);
        font-size: var(--text-lg);
        font-weight: 300;
        line-height: 1.8;
        color: var(--color-text-muted);
    }

    .bio:hover {
        transform: none;
        box-shadow: var(--shadow-offset);
        border-color: var(--color-graphite);
    }

    /* The bio doesn't react to hover, so keep its frame graphite too. */
    .bio:hover::after,
    .bio:focus-within::after {
        --frame-color: var(--color-graphite);
    }

    .bio p {
        margin: 0 0 1.25em;
        white-space: pre-line;
    }

    .link-group {
        margin-top: var(--space-lg);
    }

    .link-group-label {
        margin: 0 0 var(--space-xs);
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-widest);
        text-transform: uppercase;
        color: var(--color-slate);
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .links a {
        display: inline-block;
        padding: 0.375rem 0.75rem;
        font-size: var(--text-xs);
        font-weight: 500;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--color-text);
        border: 1px solid var(--color-slate);
        transition:
            background-color var(--ease),
            color var(--ease),
            border-color var(--ease);
    }

    .links a:hover {
        background: var(--color-accent);
        color: var(--color-ink);
        border-color: var(--color-accent);
    }

    @media (min-width: 48rem) {
        .about {
            grid-template-columns: 16rem 1fr;
        }

        .profile {
            text-align: left;
        }

        .avatar-frame {
            margin-inline: 0;
        }

        .bio {
            padding: var(--space-2xl);
        }
    }
</style>
