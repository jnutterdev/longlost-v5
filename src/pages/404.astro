---
import Base from '../layouts/Base.astro';
import Fin from '../components/Fin.astro';
---

<Base title="Signal lost">
  <section class="lost punk-card punk-card--branches punk-card--framed">
    <Fin shape="ziggurat" class="ruin" />
    <span class="code">404</span>
    <h1 class="title">signal lost.</h1>
    <p class="desc">whatever was here has been long lost and forgotten.</p>
    <a href="/" class="link">Return home</a>
  </section>
</Base>

<style>
  .lost {
    max-width: 36rem;
    margin: var(--space-3xl) auto;
    padding: var(--space-2xl);
  }

  /* A lost ruin on the horizon, above the error code. */
  .lost :global(.ruin) {
    margin: 0 0 var(--space-lg);
  }

  .lost :global(.ruin svg) {
    width: 8rem;
    height: 4rem;
  }

  .code {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-5xl);
    color: var(--color-accent);
    line-height: 1;
  }

  .title {
    margin-block: var(--space-sm);
    font-size: var(--text-3xl);
    color: var(--color-text);
  }

  .desc {
    margin: 0 0 var(--space-lg);
    font-weight: 300;
    color: var(--color-text-muted);
  }

  .link {
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-accent);
  }
</style>
