---
import 'normalize.css';
import '../styles/themes.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BackgroundBlobs from '../components/BackgroundBlobs.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const SITE_TITLE = 'longlostforgotten';

const {
  title,
  description = 'a place for ramblings, musings, fragmented thoughts, and other odds and ends.',
  image = '/images/social_basecard.png',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Mirrors applyTheme in src/lib/theme.ts; inline so the theme is set before first paint. -->
    <script is:inline>
      (() => {
        const read = key => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        };
        const palette = read('llf-palette');
        const mode = read('llf-mode');
        const prefersLight = matchMedia('(prefers-color-scheme: light)').matches;
        const isLight = mode === 'light' || (mode !== 'dark' && prefersLight);
        document.documentElement.dataset.palette = palette === 'dusk' ? 'dusk' : 'rust';
        document.documentElement.dataset.mode = isLight ? 'light' : 'dark';
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link
      rel="stylesheet"
      href="https://fonts.bunny.net/css?family=outfit:300,400,500,600|syne:400,600,700,800&display=swap"
    />
  </head>
  <body>
    <BackgroundBlobs />
    <Nav />
    <main class="main container">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .main {
    position: relative;
    z-index: 10;
    flex-grow: 1;
    padding-bottom: var(--space-3xl);
  }
</style>
